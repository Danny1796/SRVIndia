                                                                        <script>
                                                                                                        jQuery(document).ready(function ($) {
                                                                                                            $(window).on('load', function () {
                                                                                                                //$('#star-products-slider').removeClass('swiper-loader');
                                                                                                                requestAnimationFrame(() => {
                                                                                                                    // Use setTimeout to ensure elements are fully rendered before initializing Swiper
                                                                                                                    setTimeout(() => {
                                                                                                                        initializeSwiper('#star-products-slider .swiper');
                                                                                                                        //initializeSwiper('#trending-slider .swiper');
                                                                                                                    }, 100); // Adjust the delay as necessary
                                                                                                                });
                                                                                                            });

                                                                                                            function initializeSwiper(selector) {
                                                                                                                const swiperTarget = $(selector);

                                                                                                                // Destroy existing Swiper instance if it exists
                                                                                                                if (swiperTarget[0].swiper) {
                                                                                                                    swiperTarget[0].swiper.destroy(true, true);
                                                                                                                    console.log("Swiper Destroyed for " + selector);
                                                                                                                }

                                                                                                                // Append the scrollbar element dynamically
                                                                                                                const scrollbarEl = document.createElement('div');
                                                                                                                scrollbarEl.className = 'swiper-scrollbar';
                                                                                                                swiperTarget.append(scrollbarEl);

                                                                                                                // Initialize Swiper with settings
                                                                                                                const swiperInstance = new Swiper(swiperTarget[0], {
                                                                                                                    slidesPerView: 4,
                                                                                                                    loop: false,
                                                                                                                    freeMode: true,
                                                                                                                    spaceBetween: 10,
                                                                                                                    scrollbar: {
                                                                                                                        el: scrollbarEl,
                                                                                                                        draggable: true,
                                                                                                                        hide: false,
                                                                                                                        dragSize: 150,
                                                                                                                    },
                                                                                                                    breakpoints: {
                                                                                                                        320: {
                                                                                                                            slidesPerView: 1.5,
                                                                                                                            spaceBetween: 10,
                                                                                                                        },
                                                                                                                        480: {
                                                                                                                            slidesPerView: 2.5,
                                                                                                                            spaceBetween: 20,
                                                                                                                        },
                                                                                                                        640: {
                                                                                                                            slidesPerView: 3.5,
                                                                                                                            spaceBetween: 30,
                                                                                                                        },
                                                                                                                        768: {
                                                                                                                            slidesPerView: 4.4,
                                                                                                                            spaceBetween: 10,
                                                                                                                        },
                                                                                                                        1200: {
                                                                                                                            slidesPerView: 5,
                                                                                                                            spaceBetween: 10,
                                                                                                                        },
                                                                                                                    },
                                                                                                                });

                                                                                                                // Update scrollbar and Swiper instance
                                                                                                                swiperInstance.scrollbar.updateSize();
                                                                                                                swiperInstance.update();
                                                                                                                swiperTarget.addClass('finally-initialized')
                                                                                                            }
                                                                                                        });

                                                                        </script>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
