@model SRVIndia.Models.Enquiries;
@{
    ViewData["Title"] = "Home Page";
}
<div class="wrapper">
    <div class="breadcrumb"><a asp-action="Index" asp-controller="Home">Home</a><a asp-action="AboutUs" asp-controller="Home">About SRV</a><strong>Contact </strong></div>
</div>

<div class="wrapper contact-wrapper">
    <div class="contact-form">
        <h1>GET IN TOUCH</h1>
        <div class="privacynote"><p> The information you submit will only be used for our reply to your message and will not be shared or sent to third parties, as explained in the additional information. You can consult additional and detailed information in our <a href="../Privacy/index.html">Privacy Policy</a>.</p></div>
        <form asp-action="SaveEnquiry" method="post">
            <div id="contactForm" class="wow fadeInUp" data-wow-delay="0.8s">
                    <div class="form-group">
                        <label for="PersonName">Person Name:</label>
                        <input type="text" asp-for="PersonName" placeholder="Name" class="form-control">
                    </div>
                     <div class="form-group">
                        <label for="UserEmail">User Email:</label>
                        <input type="text" asp-for="UserEmail" placeholder="E-mail" class="form-control">
                    </div>
                    <div class="form-group">
                        <label for="MobileNo">Mobile No.:</label>
                        <input type="text" asp-for="MobileNo" placeholder="MobileNo" class="form-control">
                    </div>
                    <div class="form-group">
                        <label for="email">State.:</label>
                        <div class="select-selected">Select State</div>
                        <select class="form-control" asp-for="States">
                              <!-- States -->
                              <option>Andhra Pradesh</option>
                              <option>Arunachal Pradesh</option>
                              <option>Assam</option>
                              <option>Bihar</option>
                              <option>Chhattisgarh</option>
                              <option>Goa</option>
                              <option>Gujarat</option>
                              <option>Haryana</option>
                              <option>Himachal Pradesh</option>
                              <option>Jharkhand</option>
                              <option>Karnataka</option>
                              <option>Kerala</option>
                              <option>Madhya Pradesh</option>
                              <option>Maharashtra</option>
                              <option>Manipur</option>
                              <option>Meghalaya</option>
                              <option>Mizoram</option>
                              <option>Nagaland</option>
                              <option>Odisha</option>
                              <option>Punjab</option>
                              <option>Rajasthan</option>
                              <option>Sikkim</option>
                              <option>Tamil Nadu</option>
                              <option>Telangana</option>
                              <option>Tripura</option>
                              <option>Uttar Pradesh</option>
                              <option>Uttarakhand</option>
                              <option>West Bengal</option>

                              <!-- Union Territories -->
                              <option>Andaman and Nicobar Islands</option>
                              <option>Chandigarh</option>
                              <option>Dadra and Nagar Haveli and Daman and Diu</option>
                              <option>Delhi</option>
                              <option>Jammu and Kashmir</option>
                              <option>Ladakh</option>
                              <option>Lakshadweep</option>
                              <option>Puducherry</option>
                          </select>           
                    </div>
                    <div class="form-group">
                        <label for="city">City:</label>
                        <input type="text" asp-for="City" placeholder="City Name" class="form-control">
                    </div>
                    <div class="form-group">
                        <label for="ProductName">Product Name:</label>
                        <input type="text" asp-for="ProductName" placeholder="Product Name" class="form-control">
                    </div>
                    <div class="form-group">
                        <label for="BusinessType">Are You?:</label>
                        <div class="form-check">
                            <input type="radio" asp-for="BusinessType" name="businessType" class="form-check-input" value="option1">
                            <span>Retail</span>
                        </div>
                        <div class="form-check">
                            <input type="radio" asp-for="BusinessType" name="businessType" class="form-check-input" value="option2">
                            <span>Distributor</span>
                        </div>
                        <div class="form-check">
                            <input type="radio" asp-for="BusinessType" name="businessType" class="form-check-input" value="option3">
                            <span>User</span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="UserMessage">Message:</label>
                        <textarea asp-for="UserMessage" class="form-control" placeholder="Your messages here!"></textarea>
                    </div>
                    <div class="form-group">
                        <button type="submit" class="btn btn-primary">Send Enquiry</button>
                    </div>
                    </div><!--contactForm-->
                    </form>
                    </div>
                    <div class="contact-list">
                                    <div class="contact-title">Contact Us</div>
                                    <div class="branch">Below Contact.</div>
                                    <dl class="wow fadeInUp">
                                        <dt>E-mail</dt>
                                        <dd><a href="mailto:contact@srvindia.co.in">contact@srvindia.co.in</a></dd>
                                    </dl>
                                    <dl class="wow fadeInUp" data-wow-delay="0.2s">
                                        <dt>Phone </dt>
                                        <dd>+91 9920216620</dd>
                                    </dl>
                                    <dl class="wow fadeInUp" data-wow-delay="0.2s">
                                        <dt>WhatsApp </dt>
                                        <dd><a href="#">+91 9920216620</a></dd>
                                    </dl>

                                    <dl class="wow fadeInUp" data-wow-delay="0.6s">
                                        <dt>Headquarters</dt>
                                        <dd>Mumbai-Maharastra</dd>
                                    </dl>

                                    <dl class="wow fadeInUp" data-wow-delay="0.4s">
                                        <dt>Office</dt>
                                        <dd>LH-111,2nd Floor, The Platinum Mall,Pathe Bapurao Marg, Grand Road (East), Mumbai-400004.</dd>
                                    </dl>
                                </div>
</div><!--/wrapper-->
