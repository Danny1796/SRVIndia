<!-- ===================== INTRODUCTION PANEL ===================== -->
<section class="tab-panel active" id="tab-intro">
    <div class="wrapper">
        <div class="content-flex">
            <div class="content-text">
                <h3>    Advanced Nano Protection with a Premium Matte Finish</h3>
                <p>
                

                    SRV Nano Guard Matte Hydrogel Film is engineered to provide superior screen protection while delivering a smooth, glare-free viewing experience. Built with advanced Nano Guard technology and premium TPU hydrogel material, it offers exceptional flexibility, durability, and edge-to-edge coverage for modern smartphones.

                    The matte anti-glare surface reduces reflections, fingerprints, and smudges while maintaining smooth touch sensitivity. Its self-healing technology helps eliminate minor scratches and installation bubbles within 24 hours, ensuring your screen remains clean, protected, and comfortable to use every day. everyday smartphone, SRV HD Clear Hydrogel Film ensures long-lasting performance and a premium user experience.
                </p>
            </div>
            <div class="content-image" aria-label="Product detail image">
                <img src="~/images/Products/NanoGuard.PNG" alt="SRV India HD Clear Screen Protector Detail" />
            </div>
        </div>
    </div>
</section>

<!-- ===================== SPECIFICATIONS PANEL ===================== -->
<section class="tab-panel" id="tab-specs">
    <div class="wrapper">
        <h2 class="section-title">Product Specifications</h2>

        <div class="spec-grid">
            <div class="spec-item"><div class="spec-icon"><i class="fa-solid fa-flask"></i></div><h4>Material</h4><p>ESD Tempered Glass</p></div>
            <div class="spec-item"><div class="spec-icon"><i class="fa-solid fa-hand-fist"></i></div><h4>Hardness</h4><p>9H</p></div>
            <div class="spec-item"><div class="spec-icon"><i class="fa-solid fa-ruler-combined"></i></div><h4>Thickness</h4><p>0.33mm Ultra Thin</p></div>
            <div class="spec-item"><div class="spec-icon"><i class="fa-solid fa-eye"></i></div><h4>Transparency</h4><p>99.9% HD Clear</p></div>
            <div class="spec-item"><div class="spec-icon"><i class="fa-solid fa-bolt"></i></div><h4>Technology</h4><p>Super Antistatic ESD</p></div>
            <div class="spec-item"><div class="spec-icon"><i class="fa-solid fa-shield-dog"></i></div><h4>Dustproof</h4><p>HD Dustproof Coating</p></div>
            <div class="spec-item"><div class="spec-icon"><i class="fa-solid fa-fingerprint"></i></div><h4>Coating</h4><p>Anti-Fingerprint Oleophobic</p></div>
            <div class="spec-item"><div class="spec-icon"><i class="fa-solid fa-mobile-screen-button"></i></div><h4>Compatibility</h4><p>All Smartphone Models</p></div>
            <div class="spec-item"><div class="spec-icon"><i class="fa-solid fa-layer-group"></i></div><h4>Pack</h4><p>10 PCS Inner Pack</p></div>
        </div>
    </div>
</section>

<!-- ===================== FEATURES PANEL ===================== -->
<section class="tab-panel" id="tab-features">
    <div class="wrapper">
        <h2 class="section-title">Why Ultra Guard Stands Apart</h2>

        <div class="features-grid">
            <div class="feat-card">
                <div class="feat-num">01</div>
                <h4>ESD Antistatic Technology</h4>
                <p>Helps neutralize static charge — one major reason dust can stick to displays.</p>
            </div>

            <div class="feat-card">
                <div class="feat-num">02</div>
                <h4>Super HD Dustproof Barrier</h4>
                <p>Helps block airborne micro-particles to maintain clearer screen visibility.</p>
            </div>

            <div class="feat-card">
                <div class="feat-num">03</div>
                <h4>Military-Grade 9H Hardness</h4>
                <p>Rated 9H for improved resistance against daily scratches.</p>
            </div>

            <div class="feat-card">
                <div class="feat-num">04</div>
                <h4>Full Coverage Protection</h4>
                <p>Strong adhesion supports a flush fit and better edge coverage.</p>
            </div>
        </div>
    </div>
</section>

<!-- ===================== SEO SCHEMA ===================== -->
<script type="application/ld+json">
    {
      "@@context": "https://schema.org/",
      "@@type": "Product",
