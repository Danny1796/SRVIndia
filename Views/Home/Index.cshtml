                                                                                                                swiperTarget.append(scrollbarEl);

                                                                                                                // Initialize Swiper with settings
                                                                                                                const swiperInstance = new Swiper(swiperTarget[0], {
                                                                                                                    slidesPerView: 4,
                                                                                                                    loop: false,
                                                                                                                    freeMode: true,
