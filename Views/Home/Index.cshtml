                                                                                                                        },
                                                                                                                    },
                                                                                                                });

                                                                                                                // Update scrollbar and Swiper instance
                                                                                                                swiperInstance.scrollbar.updateSize();
                                                                                                                swiperInstance.update();
                                                                                                                swiperTarget.addClass('finally-initialized')
                                                                                                            }
                                                                                                        });

