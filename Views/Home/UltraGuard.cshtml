@{
    ViewData["Title"] = "SRV India - Air Guard Screen Protector";
}

<!-- ===================== BREADCRUMB ===================== -->
<section class="breadcrumb-section">
    <div class="wrapper">
        <nav class="breadcrumb" aria-label="breadcrumb">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <span class="sep"></span>
            <a asp-controller="Products" asp-action="Index">Products</a>
            <span class="sep"></span>
            <strong>Ultra Guard Screen Protector</strong>
        </nav>
    </div>
</section>

<!-- ===================== PRODUCT HERO ===================== -->
<section class="product-detail-section">
    <div class="wrapper">
        <div class="product-detail-page">

            <!-- Left: Product Image -->
            <div class="product-image-area">
                <div class="main-product-image">
                    <img src="~/images/Products/ULTRA GUARDnew.png"
                         alt="SRV India Ultra Guard Screen Protector" />
                    <div class="image-glow"></div>
                </div>
             
            </div>

            <!-- Right: Product Info -->
            <div class="product-info-area">
                <div class="product-label">Screen Protector</div>
                <h1>SRV India<br><span class="highlights"></span></h1>
                <h2>Premium Tempered Glass Protection for Smartphones</h2>
                <p class="product-short-desc">
                    Protect your smartphone display with SRV India Air Guard —
                    engineered with premium tempered glass for maximum safety,
                    ultra-clear visibility, and a seamless touch experience.
                </p>

                <div class="product-features">
                    <div class="feature-box">
                        <div class="feature-icon">🛡️</div>
                        <div>
                            <h3>9H Strong Protection</h3>
                            <p>Guards against scratches, drops, sharp objects, and daily wear.</p>
                        </div>
                    </div>
                    <div class="feature-box">
                        <div class="feature-icon">💎</div>
                        <div>
                            <h3>HD Clarity</h3>
                            <p>99.9% transparent — original display colors preserved perfectly.</p>
                        </div>
                    </div>
                    <div class="feature-box">
                        <div class="feature-icon">👆</div>
                        <div>
                            <h3>Smooth Touch</h3>
                            <p>Ultra-responsive touch sensitivity with fingerprint-friendly surface.</p>
                        </div>
                    </div>
                    <div class="feature-box">
                        <div class="feature-icon">✨</div>
                        <div>
                            <h3>Bubble Free Install</h3>
                            <p>Strong edge adhesion ensures a clean, bubble-free application.</p>
                        </div>
                    </div>
                </div>

                <div class="product-buttons">
                    <a href="javascript:void(0);" id="enquiry" class="primary-btn">
                        Become a Dealer
                    </a>
                    <a href="#model-list" class="secondary-btn">
                        View Model List
                    </a>
                </div>
            </div>

        </div>
    </div>
</section>

@* <!-- ===================== TABS ===================== -->
<section class="tab-nav">
    <div class="wrapper">
        <ul role="tablist">
            <li role="tab" class="tab-item active" data-tab="intro">Introduction</li>
            <li role="tab" class="tab-item" data-tab="specs">Specifications</li>
            <li role="tab" class="tab-item" data-tab="features">Features</li>
        </ul>
    </div>
</section> *@

<!-- ===================== INTRODUCTION PANEL ===================== -->
<section class="tab-panel active" id="tab-intro">
    <div class="wrapper">
        <div class="content-flex">
            <div class="content-text">
                <h3>Premium Tempered Glass Protection</h3>
                <p>
                    SRV India Ultra Guard Screen Protector is crafted using high-quality
                    tempered glass technology, engineered to deliver superior protection
                    for your smartphone display.
                </p>
                <p>
                    The advanced 9H hardness rating shields your screen from scratches,
                    cracks, dust, fingerprints, and accidental drops — without compromising
                    ultra-clear visibility.
                </p>
                <p>
                    With seamless touch response and bubble-free installation, Air Guard
                    guarantees a premium user experience while keeping screen sensitivity
                    completely intact.
                </p>
            </div>
            <div class="content-image">
                <img src="~/images/Products/ULTRA GUARDnew.png"
                     alt="SRV India Ultra Guard Screen Protector Detail" />
            </div>
        </div>
    </div>
</section>

<!-- ===================== SPECIFICATIONS PANEL ===================== -->
<section class="tab-panel" id="tab-specs">
    <div class="wrapper">
        <h2 class="section-title">Product Specifications</h2>
        <div class="spec-grid">
            <div class="spec-item">
                <div class="spec-icon">🧪</div>
                <h4>Material</h4>
                <p>Tempered Glass</p>
            </div>
            <div class="spec-item">
                <div class="spec-icon">💪</div>
                <h4>Hardness</h4>
                <p>9H</p>
            </div>
            <div class="spec-item">
                <div class="spec-icon">📏</div>
                <h4>Thickness</h4>
                <p>0.33mm Ultra Thin</p>
            </div>
            <div class="spec-item">
                <div class="spec-icon">🔍</div>
                <h4>Transparency</h4>
                <p>99.9% HD Clear</p>
            </div>
            <div class="spec-item">
                <div class="spec-icon">📱</div>
                <h4>Compatibility</h4>
                <p>All Smartphone Models</p>
            </div>
            <div class="spec-item">
                <div class="spec-icon">⚡</div>
                <h4>Installation</h4>
                <p>Bubble Free</p>
            </div>
        </div>
    </div>
</section>

<!-- ===================== FEATURES PANEL ===================== -->
<section class="tab-panel" id="tab-features">
    <div class="wrapper">
        <h2 class="section-title">Why Choose Ultra Guard?</h2>
        <div class="features-grid">
            <div class="feat-card">
                <div class="feat-num">01</div>
                <h4>Military-Grade Hardness</h4>
                <p>9H tempered glass is the highest hardness rating available for screen protectors — capable of resisting keys, coins, and sharp objects with ease.</p>
            </div>
            <div class="feat-card">
                <div class="feat-num">02</div>
                <h4>Crystal Clear Display</h4>
                <p>99.9% optical transparency ensures your screen looks exactly as the manufacturer intended — no colour distortion, no haze.</p>
            </div>
            <div class="feat-card">
                <div class="feat-num">03</div>
                <h4>Oleophobic Coating</h4>
                <p>The anti-fingerprint surface repels oils and smudges, keeping your display clean and your swipes smooth throughout the day.</p>
            </div>
            <div class="feat-card">
                <div class="feat-num">04</div>
                <h4>Easy Self-Installation</h4>
                <p>Alignment guide and dust-removal kit included. Install perfectly in under a minute — no professional help needed.</p>
            </div>
        </div>
    </div>
</section>

<!-- ===================== SEO SCHEMA ===================== -->
<script type="application/ld+json">
    {
      "@@context": "https://schema.org/",
      "@@type": "Product",
      "name": "SRV India Air Guard Screen Protector",
      "image": "/images/Products/ULTRA GUARDnew.png",
      "description": "Premium tempered glass screen protector with 9H hardness, 99.9% ultra-clear transparency and bubble-free installation for all smartphone models.",
      "brand": {
        "@@type": "Brand",
        "name": "SRV India"
      },
      "offers": {
        "@@type": "Offer",
        "availability": "https://schema.org/InStock"
      }
    }
</script>

<!-- ===================== STYLES ===================== -->
<style>

    /* =========================================
               CSS VARIABLES & RESET
            ========================================= */
    :root {
        --blue: #1a6bff;
        --blue-dark: #0047cc;
        --blue-light: #e8f0ff;
        --blue-glow: rgba(26,107,255,0.18);
        --ink: #0d1421;
        --ink-soft: #3a4560;
        --ink-muted: #6b7a99;
        --surface: #ffffff;
        --bg: #f4f7fd;
        --border: #dde4f0;
        --radius-lg: 0px;
        --radius-md: 14px;
        --radius-sm: 8px;
        --shadow-sm: 0 2px 12px rgba(26,107,255,0.08);
        --shadow-md: 0 6px 30px rgba(26,107,255,0.12);
        --shadow-lg: 0 12px 50px rgba(26,107,255,0.16);
        --transition: 0.28s cubic-bezier(0.4,0,0.2,1);
        --font-head: 'Georgia', 'Times New Roman', serif;
        --font-body: 'Segoe UI', system-ui, -apple-system, sans-serif;
    }

    *, *::before, *::after {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: var(--font-body);
        background: var(--bg);
        color: var(--ink);
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
    }

    img {
        max-width: 100%;
        height: auto;
        display: block;
    }

    .wrapper {
        width: 100%;
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 24px;
    }

    /* =========================================
               BREADCRUMB
            ========================================= */
    .breadcrumb-section {
        padding: 18px 0;
        border-bottom: 1px solid var(--border);
        background: var(--surface);
    }

    .breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        font-size: 13px;
        color: var(--ink-muted);
    }

        .breadcrumb a {
            color: var(--blue);
            text-decoration: none;
            transition: color var(--transition);
        }

            .breadcrumb a:hover {
                color: var(--blue-dark);
            }

        .breadcrumb .sep {
            color: var(--border);
            font-size: 16px;
        }

        .breadcrumb strong {
            color: var(--ink);
            font-weight: 600;
        }

    /* =========================================
               PRODUCT HERO SECTION
            ========================================= */
    .product-detail-section {
        padding: 56px 0 64px;
    }

    .product-detail-page {
        display: flex;
        align-items: center;
        gap: 64px;
    }

    /* --- Image Side --- */
    .product-image-area {
        flex: 0 0 480px;
        width: 100%;
    }

    .main-product-image {
        position: relative;
        background: var(--surface);
        border-radius: var(--radius-lg);
        padding: 40px;
        overflow: hidden;
    }

        .main-product-image::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(ellipse at 60% 40%, var(--blue-glow) 0%, transparent 65%);
            pointer-events: none;
        }

        .main-product-image img {
            width: 100%;
            object-fit: contain;
            position: relative;
            z-index: 1;
            transition: transform 0.5s ease;
        }

        .main-product-image:hover img {
            transform: scale(1.03);
        }

    .product-badges {
        display: flex;
        gap: 10px;
        margin-top: 20px;
        flex-wrap: wrap;
    }

    .badge {
        background: var(--blue-light);
        color: var(--blue-dark);
        padding: 8px 16px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 0.02em;
        border: 1px solid rgba(26,107,255,0.2);
        transition: all var(--transition);
    }

        .badge:hover {
            background: var(--blue);
            color: #fff;
        }

    /* --- Info Side --- */
    .product-info-area {
        flex: 1 1 0;
        min-width: 0;
    }

    .product-label {
        display: inline-block;
        background: var(--blue-light);
        color: var(--blue);
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        padding: 6px 14px;
        border-radius: 30px;
        margin-bottom: 18px;
    }

    .product-info-area h1 {
        font-family: var(--font-head);
        font-size: clamp(36px, 4vw, 54px);
        line-height: 1.1;
        margin-bottom: 18px;
        color: var(--ink);
        font-weight: 700;
    }

        .product-info-area h1 .highlights {
            color: var(--blue);
        }

    .product-info-area h2 {
        font-size: clamp(16px, 2vw, 20px);
        color: var(--ink-muted);
        margin-bottom: 22px;
        line-height: 1.5;
        font-weight: 400;
    }

    .product-short-desc {
        font-size: 15px;
        line-height: 1.85;
        margin-bottom: 36px;
        color: var(--ink-soft);
    }

    /* =========================================
               FEATURE BOXES
            ========================================= */
    .product-features {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        margin-bottom: 38px;
    }

    .feature-box {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        background: var(--surface);
        border-radius: var(--radius-md);
        padding: 20px;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--border);
        transition: all var(--transition);
    }

        .feature-box:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-md);
            border-color: rgba(26,107,255,0.25);
        }

    .feature-icon {
        font-size: 24px;
        line-height: 1;
        flex-shrink: 0;
        margin-top: 2px;
    }

    .feature-box h3 {
        font-size: 15px;
        color: var(--ink);
        margin-bottom: 6px;
        font-weight: 700;
    }

    .feature-box p {
        font-size: 13px;
        line-height: 1.65;
        color: var(--ink-muted);
    }

    /* =========================================
               BUTTONS
            ========================================= */
    .product-buttons {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
    }

    .primary-btn,
    .secondary-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 14px 28px;
        border-radius: var(--radius-sm);
        text-decoration: none;
        font-weight: 700;
        font-size: 15px;
        transition: all var(--transition);
        letter-spacing: 0.02em;
        white-space: nowrap;
        cursor: pointer;
    }

    .primary-btn {
        background: var(--blue);
        color: #fff;
        box-shadow: 0 4px 18px rgba(26,107,255,0.35);
    }

        .primary-btn:hover {
            background: var(--blue-dark);
            box-shadow: 0 6px 24px rgba(26,107,255,0.45);
            transform: translateY(-2px);
            color: #fff;
        }

    .secondary-btn {
        background: transparent;
        color: var(--blue);
        border: 2px solid var(--blue);
    }

        .secondary-btn:hover {
            background: var(--blue-light);
            transform: translateY(-2px);
            color: var(--blue-dark);
        }

    /* =========================================
               TAB NAV
            ========================================= */
    .tab-nav {
        background: var(--surface);
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
        position: sticky;
        top: 0;
        z-index: 50;
    }

        .tab-nav ul {
            display: flex;
            align-items: center;
            gap: 0;
            list-style: none;
            overflow-x: auto;
            scrollbar-width: none;
        }

            .tab-nav ul::-webkit-scrollbar {
                display: none;
            }

    .tab-item {
        padding: 18px 28px;
        font-weight: 600;
        font-size: 14px;
        cursor: pointer;
        transition: all var(--transition);
        color: var(--ink-muted);
        position: relative;
        white-space: nowrap;
        letter-spacing: 0.02em;
        user-select: none;
    }

        .tab-item::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%) scaleX(0);
            width: 60%;
            height: 3px;
            background: var(--blue);
            border-radius: 3px 3px 0 0;
            transition: transform var(--transition);
        }

        .tab-item:hover {
            color: var(--blue);
        }

        .tab-item.active {
            color: var(--blue);
        }

            .tab-item.active::after {
                transform: translateX(-50%) scaleX(1);
            }

    /* =========================================
               TAB PANELS
            ========================================= */
    .tab-panel {
        display: none;
        padding: 72px 0;
    }

        .tab-panel.active {
            display: block;
        }

    /* Introduction panel */
    .content-flex {
        display: flex;
        align-items: center;
        gap: 60px;
    }

    .content-text {
        flex: 1 1 0;
    }

        .content-text h3 {
            font-family: var(--font-head);
            font-size: clamp(26px, 3vw, 38px);
            margin-bottom: 28px;
            color: var(--ink);
            line-height: 1.2;
        }

        .content-text p {
            font-size: 15px;
            line-height: 1.9;
            margin-bottom: 18px;
            color: var(--ink-soft);
        }

            .content-text p:last-child {
                margin-bottom: 0;
            }

    .content-image {
        flex: 0 0 420px;
    }

        .content-image img {
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-lg);
            width: 100%;
        }

    /* =========================================
               SPECIFICATIONS PANEL
            ========================================= */
    .section-title {
        text-align: center;
        font-family: var(--font-head);
        font-size: clamp(28px, 3.5vw, 42px);
        margin-bottom: 52px;
        color: var(--ink);
    }

    .spec-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
    }

    .spec-item {
        background: var(--surface);
        padding: 32px 24px;
        border-radius: var(--radius-lg);
        text-align: center;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--border);
        transition: all var(--transition);
    }

        .spec-item:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-md);
            border-color: rgba(26,107,255,0.25);
        }

    .spec-icon {
        font-size: 30px;
        margin-bottom: 14px;
    }

    .spec-item h4 {
        color: var(--blue);
        margin-bottom: 10px;
        font-size: 16px;
        font-weight: 700;
        letter-spacing: 0.02em;
    }

    .spec-item p {
        color: var(--ink-soft);
        font-size: 15px;
        font-weight: 500;
    }

    /* =========================================
               FEATURES PANEL
            ========================================= */
    .features-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 28px;
    }

    .feat-card {
        background: var(--surface);
        padding: 36px 32px;
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--border);
        transition: all var(--transition);
        position: relative;
        overflow: hidden;
    }

        .feat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 4px;
            height: 100%;
            background: var(--blue);
            border-radius: 4px 0 0 4px;
        }

        .feat-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-md);
        }

    .feat-num {
        font-family: var(--font-head);
        font-size: 48px;
        font-weight: 700;
        color: var(--blue-light);
        line-height: 1;
        margin-bottom: 14px;
        letter-spacing: -2px;
    }

    .feat-card h4 {
        font-size: 18px;
        font-weight: 700;
        color: var(--ink);
        margin-bottom: 12px;
    }

    .feat-card p {
        font-size: 14px;
        line-height: 1.8;
        color: var(--ink-muted);
    }

    /* =========================================
               RESPONSIVE — LARGE TABLETS (max 1100px)
            ========================================= */
    @@media (max-width: 1100px) {
        .product-image-area {
            flex: 0 0 400px;
        }

        .product-detail-page {
            gap: 48px;
        }

        .spec-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    /* =========================================
               RESPONSIVE — TABLETS (max 900px)
            ========================================= */
    @@media (max-width: 900px) {
        .product-detail-page {
            flex-direction: column;
            gap: 40px;
        }

        .product-image-area {
            flex: none;
            width: 100%;
            max-width: 520px;
            margin: 0 auto;
        }

        .product-info-area {
            width: 100%;
        }

        .content-flex {
            flex-direction: column;
            gap: 40px;
        }

        .content-image {
            flex: none;
            width: 100%;
            max-width: 440px;
            margin: 0 auto;
        }

        .spec-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .features-grid {
            grid-template-columns: 1fr;
        }
    }

    /* =========================================
               RESPONSIVE — MOBILE (max 640px)
            ========================================= */
    @@media (max-width: 640px) {
        .wrapper {
            padding: 0 16px;
        }

        .product-detail-section {
            padding: 32px 0 40px;
        }

        .main-product-image {
            padding: 2px;
        }

        .product-info-area h1 {
            font-size: 32px;
        }

        .product-features {
            grid-template-columns: 1fr;
        }

        .product-buttons {
            flex-direction: column;
        }

        .primary-btn,
        .secondary-btn {
            width: 100%;
        }

        .spec-grid {
            grid-template-columns: 1fr 1fr;
            gap: 14px;
        }

        .tab-item {
            padding: 16px 18px;
            font-size: 13px;
        }

        .tab-panel {
            padding: 48px 0;
        }

        .section-title {
            margin-bottom: 36px;
        }
    }

    /* =========================================
               RESPONSIVE — SMALL MOBILE (max 400px)
            ========================================= */
    @@media (max-width: 400px) {
        .product-info-area h1 {
            font-size: 26px;
        }

        .spec-grid {
            grid-template-columns: 1fr;
        }

        .badge {
            font-size: 12px;
            padding: 7px 13px;
        }
    }

    /* =========================================
               PAGE-SCOPED STYLES
            ========================================= */
    .ultraguard-wrapper { font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial; color: #111; }

    /* Image gallery layout */
    .product-gallery { width: 100%; display: flex; flex-direction: column; gap: 12px; align-items: center; }
    .product-main-image { width: 100%; max-width: 560px; height: auto; display: block; border: 1px solid #000; border-radius: 0 !important; box-shadow: none !important; background: #fff; -webkit-tap-highlight-color: transparent; -webkit-user-select: none; user-select: none; outline: none; }

    /* Thumbnails */
    .product-thumbs { display: flex; gap: 10px; justify-content: center; }
    .product-thumb { width: 86px; height: auto; display: block; border: 1px solid #000; border-radius: 0 !important; box-shadow: none !important; background: #fff; -webkit-tap-highlight-color: transparent; user-select: none; cursor: pointer; }
    .product-thumb.active { border: 2px solid #000; }

    /* Remove any hover/highlight effects inherited from other CSS */
    .ultraguard-wrapper img { transition: none !important; filter: none !important; -webkit-filter: none !important; }
    .ultraguard-wrapper img:hover, .ultraguard-wrapper img:focus, .ultraguard-wrapper img:active { box-shadow: none !important; transform: none !important; opacity: 1 !important; }

    /* Desktop layout: thumbs vertical on right */
    @@media (min-width: 992px) {
      .product-gallery { flex-direction: row; align-items: flex-start; gap: 24px; }
      .product-thumbs { flex-direction: column; gap: 12px; justify-content: flex-start; }
      .product-thumb { width: 100px; }
    }

    /* Accessibility focus ring for keyboard users, subtle and not glowing */
    .product-thumb:focus { outline: 2px solid rgba(0,0,0,0.12); outline-offset: 2px; }
</style>

<!-- ===================== TAB SCRIPT ===================== -->
<script>
    (function () {
        const tabs = document.querySelectorAll('.tab-item');
        const panels = document.querySelectorAll('.tab-panel');

        tabs.forEach(function (tab) {
            tab.addEventListener('click', function () {
                // Deactivate all
                tabs.forEach(function (t) { t.classList.remove('active'); });
                panels.forEach(function (p) { p.classList.remove('active'); });

                // Activate clicked
                tab.classList.add('active');
                var target = document.getElementById('tab-' + tab.dataset.tab);
                if (target) { target.classList.add('active'); }
            });
        });
    })();

    (function(){
      const main = document.getElementById('mainImage');
      const thumbs = document.querySelectorAll('.product-thumb');
      if(!main || !thumbs.length) return;

      function activateThumb(t){
        thumbs.forEach(x => x.classList.remove('active'));
        t.classList.add('active');
        const large = t.getAttribute('data-large') || t.src;
        // update main src and attempt to update srcset if present
        main.src = large;
        // If thumbnails hold srcset data-large-srcset, we could set main.srcset
        // keep a simple approach: set main.src only so it stays clear and simple
      }

      thumbs.forEach(t => {
        t.addEventListener('click', () => activateThumb(t));
        t.addEventListener('keydown', (e) => {
          if(e.key === 'Enter' || e.key === ' ') { e.preventDefault(); activateThumb(t); }
        });
      });
    })();
</script>
