@{
    ViewData["Title"] = "Why Choose SRV";
}

<!-- Font Awesome CDN -->
<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />

<style>
    body {
        font-family: 'Segoe UI', sans-serif;
        background: #f4f6fb;
        margin: 0;
        padding: 0;
    }

    /* HERO */
    .heroW {
        background: linear-gradient(135deg, #e27c16, #feb47b);
        color: white;
        text-align: center;
        padding: 60px 20px;
    }

        .heroW h1 {
            font-size: 3rem;
            margin-bottom: 10px;
        }

        .heroW p {
            font-size: 1.3rem;
            margin: 0;
        }

    /* Container */
    .container {
        max-width: 1100px;
        margin: auto;
        padding: 50px 20px;
    }

    .intro {
        text-align: center;
        max-width: 850px;
        margin: auto;
        font-size: 1.1rem;
        color: #555;
        line-height: 1.8;
    }

    /* Grid */
    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 25px;
        margin-top: 50px;
    }

    /* Card */
    .card {
        background: #fff;
        padding: 30px 25px;
        border-radius: 15px;
        text-align: center;
        box-shadow: 0 10px 25px rgba(0,0,0,.08);
        transition: .4s;
        position: relative;
        overflow: hidden;
    }

        .card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(0,0,0,.15);
        }

        .card::before {
            content: "";
            position: absolute;
            top: -100%;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(120deg, transparent, rgba(255,255,255,.3), transparent);
            transition: .6s;
        }

        .card:hover::before {
            top: 100%;
        }

    /* Icons */
    .icon {
        font-size: 55px;
        color: #e27c16;
        margin-bottom: 20px;
        transition: .4s;
    }

    .card:hover .icon {
        color: #11998e;
        transform: scale(1.2) rotate(10deg);
    }

    /* Card Title */
    .card h3 {
        color: #222;
        margin-bottom: 15px;
        font-size: 1.4rem;
    }

    /* Card Text */
    .card p {
        color: #666;
        line-height: 1.7;
        font-size: 1rem;
    }

    /* Highlight */
    .highlight-box {
        margin-top: 60px;
        background: linear-gradient(135deg,#11998e,#38ef7d);
        color: white;
        border-radius: 20px;
        padding: 45px 25px;
        text-align: center;
    }

        .highlight-box h2 {
            margin-bottom: 10px;
        }

    .stats {
        display: flex;
        justify-content: space-around;
        flex-wrap: wrap;
        margin-top: 35px;
        gap: 20px;
    }

        .stats div {
            min-width: 150px;
        }

    .counter {
        font-size: 2.5rem;
        font-weight: bold;
    }

    .stats p {
        margin-top: 8px;
        font-size: 1.1rem;
    }

    @@media (max-width:768px) {

        .heroW h1 {
            font-size: 2.2rem;
        }

        .heroW p {
            font-size: 1rem;
        }

        .stats {
            flex-direction: column;
            align-items: center;
        }
    }
</style>

<!-- HERO -->
<div class="heroW">
    <h1>Why Choose SRV India</h1>
    <p>Your Trusted Mobile Accessories Wholesale Partner</p>
</div>

<div class="container">

    <!-- Introduction -->
    <div class="intro">
        <p>
            At <strong>SRV India</strong>, we go beyond just supplying products.
            We provide premium-quality mobile accessories, competitive pricing,
            dependable service, and long-term business partnerships that help
            retailers and distributors grow successfully across India.
        </p>
    </div>

    <!-- Feature Cards -->
    <div class="grid">

        <div class="card">
            <div class="icon">
                <i class="fas fa-mobile-screen-button"></i>
            </div>
            <h3>Wide Product Range</h3>
            <p>
                All types of mobile accessories, chargers, cables,
                tempered glass, covers, earphones, and more under one roof.
            </p>
        </div>

        <div class="card">
            <div class="icon">
                <i class="fas fa-star"></i>
            </div>
            <h3>Premium Quality</h3>
            <p>
                Every product undergoes strict quality checks
                to ensure reliability, durability, and customer satisfaction.
            </p>
        </div>

        <div class="card">
            <div class="icon">
                <i class="fas fa-tags"></i>
            </div>
            <h3>Best Wholesale Pricing</h3>
            <p>
                Affordable wholesale rates designed to maximize
                your business profits and growth.
            </p>
        </div>

        <div class="card">
            <div class="icon">
                <i class="fas fa-truck-fast"></i>
            </div>
            <h3>Fast Delivery</h3>
            <p>
                Quick order processing and reliable delivery
                services across India.
            </p>
        </div>

        <div class="card">
            <div class="icon">
                <i class="fas fa-handshake"></i>
            </div>
            <h3>Trusted Partnership</h3>
            <p>
                Building long-term relationships through trust,
                transparency, and consistent support.
            </p>
        </div>

        <div class="card">
            <div class="icon">
                <i class="fas fa-bolt"></i>
            </div>
            <h3>Latest Market Trends</h3>
            <p>
                Stay ahead with the newest and highest-demand
                mobile accessories in the market.
            </p>
        </div>

    </div>

    <!-- Statistics -->
    <div class="highlight-box">

        <h2>Growing with SRV India</h2>

        <p>
            Empowering retailers and distributors with quality,
            reliability, and timely delivery.
        </p>

        <div class="stats">

            <div>
                <div class="counter" data-target="100">0</div>
                <p>Happy Clients</p>
            </div>

            <div>
                <div class="counter" data-target="50">0</div>
                <p>Cities Served</p>
            </div>

            <div>
                <div class="counter" data-target="500">0</div>
                <p>Products Available</p>
            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        // Card Animation
        const cards = document.querySelectorAll(".card");

        cards.forEach((card, index) => {

            card.style.opacity = "0";
            card.style.transform = "translateY(40px)";

            setTimeout(() => {

                card.style.transition = ".6s";
                card.style.opacity = "1";
                card.style.transform = "translateY(0)";

            }, index * 150);

        });


        // Counter Animation

        const counters = document.querySelectorAll(".counter");

        counters.forEach(counter => {

            function updateCounter() {

                const target = +counter.getAttribute("data-target");
                const count = +counter.innerText;

                const increment = Math.ceil(target / 50);

                if (count < target) {

                    counter.innerText = count + increment;

                    setTimeout(updateCounter, 30);

                } else {

                    counter.innerText = target;

                }

            }

            updateCounter();

        });

    </script>

}