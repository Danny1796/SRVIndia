<!-- ===================== STYLES (clean + professional, white UI) ===================== -->
<style>
    :root {
        --bg: #ffffff;
        --surface: #ffffff;
        --surface-2: #f6f6f6;
        --text: #111111;
        --muted: #4a4a4a;
        --border: rgba(0,0,0,.18);
        --border-2: rgba(0,0,0,.28);
        --radius: 12px;
        --radius-lg: 16px;
        --shadow: none;
        --font: Inter, system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
    }

    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        font-family: var(--font);
        background: var(--bg);
        color: var(--text);
    }

    img {
        max-width: 100%;
        height: auto;
        display: block;
    }

    .wrapper {
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 18px;
    }

    /* Breadcrumb */
    .breadcrumb-section {
        padding: 14px 0;
        border-bottom: 1px solid var(--border);
        background: #fff;
    }

    .breadcrumb {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
        font-size: 14px;
        color: var(--muted);
    }

        .breadcrumb a {
            color: var(--text);
            text-decoration: none;
            font-weight: 600;
        }

            .breadcrumb a:hover {
                text-decoration: underline;
            }

        .breadcrumb .sep {
            color: #777;
        }

    /* Hero */
    .product-detail-section {
        padding: 34px 0 22px;
        background: #fff;
    }

    .product-detail-page {
        display: flex;
        gap: 56px;
        align-items: flex-start;
    }

    .product-image-area {
        flex: 0 0 460px;
    }

    /* Simple image card with black border */
    .main-product-image {
        background: #fff;
        border: 2px solid #000;
        padding: 16px;
        border-radius: 0;
    }

    .product-badges {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 14px;
    }

    .badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border: 1px solid var(--border);
        background: #fff;
        padding: 8px 12px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 700;
        color: var(--text);
    }

    .product-info-area {
        flex: 1;
        min-width: 0;
        padding-top: 6px;
    }

    .product-label {
        display: inline-block;
        border: 1px solid var(--border);
        background: var(--surface-2);
        padding: 7px 14px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: .06em;
        text-transform: uppercase;
        margin-bottom: 12px;
    }

    h1 {
        font-size: clamp(2px,4vw,50px);
        line-height: 1.05;
        margin-bottom: 10px;
        font-weight: 600;
    }

    .brand-name {
        font-weight: 500;
        text-decoration-color: lawngreen;
    }

    h2 {
        font-size: clamp(2px,2.1vw,20px);
        font-weight: 600;
        margin-bottom: 16px;
        color: var(--text);
    }

    .product-short-desc {
        font-size: 15px;
        line-height: 1.85;
        color: var(--muted);
        margin-bottom: 22px;
        max-width: 620px;
    }

    .product-features {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-bottom: 18px;
    }

    .feature-box {
        border: 1px solid var(--border);
        background: #fff;
        border-radius: var(--radius);
        padding: 16px;
        display: flex;
        gap: 12px;
        align-items: flex-start;
    }

    .feature-icon {
        width: 34px;
        height: 34px;
        border: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        flex: 0 0 auto;
    }

        .feature-icon i {
            font-size: 15px;
        }

    .feature-box h3 {
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 6px;
    }

    .feature-box p {
        font-size: 13px;
        line-height: 1.65;
        color: var(--muted);
    }

    .pack-info {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 18px;
    }

    .pack-badge {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        border: 1px solid var(--border);
        background: var(--surface-2);
        padding: 10px 14px;
        border-radius: var(--radius);
        font-weight: 600;
        font-size: 13px;
    }

    .product-buttons {
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
    }

    .primary-btn, .secondary-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 12px 22px;
        border-radius: 10px;
        border: 1px solid var(--border);
        text-decoration: none;
        font-weight: 600;
        font-size: 14px;
        background: #fff;
        color: var(--text);
    }

    .primary-btn {
        border-color: #000;
    }

    /* Tabs */
    .tab-nav {
        background: #fff;
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
        position: sticky;
        top: 0;
        z-index: 50;
    }

    .tablist {
        display: flex;
        gap: 0;
        list-style: none;
        overflow-x: auto;
    }

    .tab-item {
        padding: 14px 18px;
        font-weight: 600;
        font-size: 14px;
        cursor: pointer;
        border-bottom: 3px solid transparent;
        white-space: nowrap;
        color: #6a6a6a;
    }

        .tab-item:hover {
            color: var(--text);
        }

        .tab-item.active {
            color: var(--text);
            border-bottom-color: #000;
        }

    .tab-panel {
        display: none;
        padding: 40px 0;
        background: #fff;
    }

        .tab-panel.active {
            display: block;
        }

    .content-flex {
        display: flex;
        gap: 44px;
        align-items: flex-start;
    }

    .content-text {
        flex: 1;
    }

        .content-text h3 {
            font-size: clamp(22px,2.7vw,34px);
            margin-bottom: 16px;
            font-weight: 600;
        }

        .content-text p {
            font-size: 15px;
            line-height: 1.9;
            color: var(--muted);
            margin-bottom: 14px;
        }

            .content-text p:last-child {
                margin-bottom: 0;
            }

    .content-image {
        flex: 0 0 380px;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        background: #fff;
        padding: 10px;
    }

    .section-title {
        text-align: center;
        font-size: clamp(26px,3.2vw,42px);
        margin-bottom: 28px;
        font-weight: 600;
    }

    /* Specs */
    .spec-grid {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 14px;
    }

    .spec-item {
        border: 1px solid var(--border);
        background: #fff;
        border-radius: var(--radius-lg);
        padding: 22px 14px;
        text-align: center;
    }

    .spec-icon {
        font-size: 22px;
        margin-bottom: 8px;
        color: var(--text);
    }

    .spec-item h4 {
        font-size: 14px;
        font-weight: 800;
        margin-bottom: 8px;
        text-transform: uppercase;
        letter-spacing: .03em;
    }

    .spec-item p {
        font-size: 13px;
        font-weight: 700;
        color: var(--muted);
    }

    /* Features */
    .features-grid {
        display: grid;
        grid-template-columns: repeat(2,1fr);
        gap: 14px;
    }

    .feat-card {
        border: 1px solid var(--border);
        background: #fff;
        border-radius: var(--radius-lg);
        padding: 26px 18px;
        position: relative;
    }

    .feat-num {
        font-family: var(--font);
        font-weight: 1000;
        font-size: 56px;
        letter-spacing: -2px;
        color: rgba(0,0,0,.08);
        line-height: 1;
        margin-bottom: 12px;
    }

    .feat-card h4 {
        font-size: 16px;
        font-weight: 1000;
        margin-bottom: 10px;
    }

    .feat-card p {
        font-size: 14px;
        line-height: 1.8;
        color: var(--muted);
    }

    /* Responsive */
    @@media (max-width: 1100px) {
        .product-detail-page {
            gap: 40px;
        }

        .product-image-area {
            flex-basis: 420px;
        }

        .content-image {
            flex-basis: 330px;
        }

        .spec-grid {
            grid-template-columns: repeat(3,1fr);
        }
    }

    @@media (max-width: 900px) {
        .product-detail-page {
            flex-direction: column;
            gap: 24px;
        }

        .product-image-area {
            flex-basis: auto;
            max-width: 560px;
            margin: 0 auto;
        }

        .content-flex {
            flex-direction: column;
            gap: 22px;
        }

        .content-image {
            flex-basis: auto;
            max-width: 480px;
            margin: 0 auto;
        }

        .spec-grid {
            grid-template-columns: repeat(2,1fr);
        }

        .features-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 640px) {
        .wrapper {
            padding: 0 14px;
        }

        .product-features {
            grid-template-columns: 1fr;
        }

        .spec-grid {
            grid-template-columns: repeat(2,1fr);
        }

        .tab-item {
            padding: 12px 14px;
            font-size: 13px;
        }

        .content-image {
            padding: 8px;
        }
    }

    @@media (max-width: 420px) {
        .spec-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<!-- ===================== TAB SCRIPT (kept) ===================== -->
<script>
    (function () {
        var tabs = document.querySelectorAll('.tab-item');
        var panels = document.querySelectorAll('.tab-panel');

        tabs.forEach(function (tab) {
            tab.addEventListener('click', function () {
                tabs.forEach(function (t) { t.classList.remove('active'); });
                panels.forEach(function (p) { p.classList.remove('active'); });
                tab.classList.add('active');
                var target = document.getElementById('tab-' + tab.dataset.tab);
                if (target) target.classList.add('active');
            });
        });
    })();
</script>

