@{
    ViewData["Title"] = "Our Mission";
}

<!-- ✅ CSS -->
<style>
    body {
        font-family: 'Segoe UI', sans-serif;
        background: #f5f7fb;
    }

    /* 🔥 HERO BANNER */
    .mission-hero {
        background: linear-gradient(135deg, #e27c16, #feb47b);
        color: white;
        text-align: center;
        padding: 30px 0px;
    }

        .mission-hero h1 {
            font-size: 2.8rem;
            margin-bottom: 10px;
        }

        .mission-hero p {
            font-size: 1.2rem;
            opacity: 0.9;
        }

    /* Container */
    .container {
        max-width: 1100px;
        margin: auto;
        padding: 20px 0px;
    }

    /* Tagline */
    .tagline {
        text-align: center;
        font-size: 1.5rem;
        font-weight: bold;
        color: :black;
        margin-bottom: 30px;
    }

    /* Grid */
    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 25px;
    }

    /* Card */
    .card {
        background: white;
        padding: 25px;
        border-radius: 15px;
        text-align: center;
        box-shadow: 0 8px 20px rgba(0,0,0,0.08);
        transition: 0.3s;
    }

        .card:hover {
            transform: translateY(-5px);
        }

    /* Icon */
    .icon {
        font-size: 40px;
        margin-bottom: 10px;
    }

    /* Title */
    .card h3 {
        margin-bottom: 10px;
        color: #333;
    }

    /* Description */
    .card p {
        color: #555;
        font-size: 0.95rem;
    }

    /* Footer Quote */
    .quote {
        margin-top: 50px;
        text-align: center;
        font-size: 1.2rem;
        color: #555;
    }
</style>

<!-- 🔥 HERO -->
<div class="mission-hero">
    <h1>Our Mission</h1>
    <p>Empowering the Digital Generation of India</p>
</div>

<div class="container">

    <!-- ✅ TAGLINE -->
    <div class="tagline">
        "Power of Dream - Believe in your dreams, create your future.".
    </div>

    <!-- ✅ INTRO -->
    <p style="text-align:center; max-width:800px; margin:auto;">
        At <strong>SRV India</strong>, our mission is to empower the digital generation
        by delivering <strong>premium mobile accessories</strong> that enhance everyday life.
        We believe technology should be simple, reliable, and accessible to everyone.
    </p>

    <!-- ✅ CORE VALUES -->
    <div class="grid" style="margin-top:40px;">

        <div class="card">
            <div class="icon">🚀</div>
            <h3>Innovation</h3>
            <p>
                We continuously innovate to create durable, stylish, and high-performance
                products that simplify everyday digital experiences.
            </p>
        </div>

        <div class="card">
            <div class="icon">⭐</div>
            <h3>Quality</h3>
            <p>
                We maintain uncompromising quality standards in every product,
                ensuring reliability, safety, and long-lasting performance.
            </p>
        </div>

        <div class="card">
            <div class="icon">🤝</div>
            <h3>Connection</h3>
            <p>
                We build meaningful relationships with our customers, ensuring
                trust, support, and satisfaction in every interaction.
            </p>
        </div>

    </div>

    <!-- ✅ QUOTE -->
    <div class="quote">
        “SRV – Power of Dream”
    </div>

</div>

<!-- ✅ JS Animation -->
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll(".card").forEach((card, index) => {
                card.style.opacity = "0";
                card.style.transform = "translateY(20px)";

                setTimeout(() => {
                    card.style.transition = "0.5s";
                    card.style.opacity = "1";
                    card.style.transform = "translateY(0)";
                }, index * 200);
            });
        });
    </script>
}