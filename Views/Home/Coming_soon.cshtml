@{
    ViewData["Title"] = "Mobile Accessories";
}

<style>
    body {
        background: #f5f7fa;
    }

    .coming-section {
        min-height: 85vh;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .coming-card {
        background: #fff;
        border-radius: 20px;
        padding: 50px;
        text-align: center;
        box-shadow: 0 10px 35px rgba(0,0,0,.12);
        max-width: 700px;
        width: 100%;
    }

        .coming-card img {
            width: 180px;
            margin-bottom: 25px;
        }

        .coming-card h1 {
            font-size: 42px;
            font-weight: bold;
            color: #0d6efd;
        }

        .coming-card h4 {
            color: #555;
            margin-top: 15px;
        }

        .coming-card p {
            color: #666;
            font-size: 18px;
            margin-top: 20px;
        }

    .badge-coming {
        display: inline-block;
        background: #ffc107;
        color: #000;
        padding: 8px 20px;
        border-radius: 30px;
        font-weight: bold;
        margin-top: 20px;
    }

    .btn-home {
        margin-top: 30px;
        border-radius: 30px;
        padding: 12px 30px;
    }
</style>

<div class="container coming-section">

    <div class="coming-card">

        <img src="https://cdn-icons-png.flaticon.com/512/1048/1048941.png" alt="Mobile Accessories">

        <div class="badge-coming">
            🚀 Launching Soon
        </div>

        <h1>Mobile Accessories</h1>

        <h4>Coming Soon on SRV INDIA</h4>

        <p>
            We are working hard to bring you a premium collection of
            <strong>
                Mobile Chargers, Earbuds, Power Banks, USB Cables,
                Mobile Covers, Screen Guards, Smart Gadgets
            </strong>
            and many more accessories.
        </p>

        <p>
            Stay connected with <strong>SRV INDIA</strong>.
            Our Mobile Accessories Store will be available soon.
        </p>

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-primary btn-home">
            ⬅ Back to Home
        </a>

    </div>

</div>