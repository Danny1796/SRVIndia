@{
	ViewData["Title"] = "Home Page";
}
<div class="wrapper">
	<div class="breadcrumb"><a href="../index.html">Home</a><a href="../About-Us/index.html">About SRV</a><strong>Contact </strong></div>
</div>

<div class="wrapper contact-wrapper">
	<div class="contact-form">
		<h1>GET IN TOUCH</h1>
		<div class="privacynote"><p> The information you submit will only be used for our reply to your message and will not be shared or sent to third parties, as explained in the additional information. You can consult additional and detailed information in our <a href="../Privacy/index.html">Privacy Policy</a>.</p></div>
		<div id="contactForm" class="wow fadeInUp" data-wow-delay="0.8s">
			<div class="input-form">
				<div class="input-box">
					<input type="text" name="customerName" placeholder="Name" class="customerName">
				</div>
				<div class="input-box">
					<input type="text" name="company" placeholder="Company" class="company">
				</div>
				<div class="input-box">
					<input type="text" name="whatsapp" placeholder="WhatsApp" class="whatsapp">
				</div>
				<div class="input-box">
					<input type="email" name="email" placeholder="E-mail" class="email">
				</div>
				<div class="input-box">
					<div class="select-selected">Do you have cargo from China?</div>
					<div class="select-list">
						<div class="select-option">Yes</div>
						<div class="select-option">No</div>
					</div>
					<input type="hidden" name="cargo" class="cargo" value="">
				</div>
				<div class="input-box">
					<div class="select-selected">What's your business type?</div>
					<div class="select-list">
						<div class="select-option">Retail</div>
						<div class="select-option">Intermediary trade</div>
						<div class="select-option">Wholesaler</div>
						<div class="select-option">Others</div>
					</div>
					<input type="hidden" name="business" class="business" value="">
				</div>
				<div class="input-textarea">
					<textarea name="message" class="message" placeholder="Your messages here!"></textarea>
				</div>
					
			</div>
			<input type="button" class="submit-from" value="SEND">
		</div><!--contactForm-->
	</div>
	
	
	<div class="contact-list">
		<div class="contact-title">Contact Us</div>
		<div class="branch">Below Contact.</div>
		<dl class="wow fadeInUp">
			<dt>E-mail</dt>
			<dd><a href="mailto:contact@srvindia.co.in">contact@srvindia.co.in</a></dd>
		</dl>
		<dl class="wow fadeInUp" data-wow-delay="0.2s">
			<dt>Phone </dt>
			<dd>+91 9920216620</dd>
		</dl>
		<dl class="wow fadeInUp" data-wow-delay="0.2s">
			<dt>WhatsApp </dt>
			<dd><a href="#">+91 9920216620</a></dd>
		</dl>

		<dl class="wow fadeInUp" data-wow-delay="0.6s">
			<dt>Headquarters</dt>
			<dd>Mumbai-Maharastra</dd>
		</dl>
			
		<dl class="wow fadeInUp" data-wow-delay="0.4s">
			<dt>Office</dt>
			<dd>LH-111,2nd Floor, The Platinum Mall,Pathe Bapurao Marg, Grand Road (East), Mumbai-400004.</dd>
		</dl>
	</div>

</div><!--/wrapper-->