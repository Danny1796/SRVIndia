@{
    ViewData["Title"] = "Why Choose SRV";
}

<!-- ✅ CSS -->
<style>
    body {
        font-family: 'Segoe UI', sans-serif;
        background: #f4f6fb;
    }

    /* 🔥 HERO */
    .heroW {
        background: linear-gradient(135deg, #e27c16, #feb47b);
        color: white;
        text-align: center;
        padding: 30px 0px;
    }

        .heroW h1 {
            font-size: 3.8rem;
        }

        .heroW p {
            font-size: 2.2rem;
        }

    /* Container */
    .container {
        max-width: 1100px;
        margin: auto;
        padding: 20px 0px;
    }

    /* Grid */
    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 25px;
    }

    /* Card */
    .card {
        background: white;
        padding: 25px;
        border-radius: 15px;
        text-align: center;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        transition: 0.4s;
        position: relative;
        overflow: hidden;
    }

        /* Hover effect */
        .card:hover {
            transform: translateY(-8px) scale(1.02);
        }

        /* Glow effect */
        .card::before {
            content: "";
            position: absolute;
            width: 100%;
            height: 100%;
            background: linear-gradient(120deg, transparent, rgba(0,255,150,0.2), transparent);
            top: -100%;
            left: 0;
            transition: 0.5s;
        }

        .card:hover::before {
            top: 100%;
        }

    /* Icon */
    .icon {
        font-size: 45px;
        margin-bottom: 10px;
    }

    /* Title */
    .card h3 {
        margin-bottom: 10px;
        color: #333;
    }

    /* Text */
    .card p {
        color: #555;
        font-size: 1.95rem;
    }

    /* Highlight Section */
    .highlight-box {
        background: linear-gradient(135deg, #38ef7d, #11998e);
        color: white;
        padding: 40px;
        border-radius: 20px;
        text-align: center;
        margin-top: 50px;
    }

    /* Counter */
    .counter {
        font-size: 2rem;
        font-weight: bold;
    }

    /* Responsive */
   @@media(max - width:600px) {
        .hero h1 {
            font-size: 2rem;
        }
    }
</style>

<!-- 🔥 HERO -->
<div class="heroW">
    <h1>Why Choose SRV India</h1>
    <p>Your Trusted Mobile Accessories Wholesale Partner</p>
</div>

<div class="container">

    <!-- ✅ INTRO -->
    <p style="text-align:center; max-width:800px; margin:auto;">
        At <strong>SRV India</strong>, we go beyond just supplying products.
        We deliver <strong>quality, trust, and long-term business growth</strong>
        for our partners across India.
    </p>

    <!-- ✅ FEATURES -->
    <div class="grid" style="margin-top:40px;">

        <div class="card">
            <div class="icon">📱</div>
            <h3>Wide Product Range</h3>
            <p>All types of mobile accessories and tempered glass under one roof.</p>
        </div>

        <div class="card">
            <div class="icon">⭐</div>
            <h3>Premium Quality</h3>
            <p>Strict quality checks to ensure durable and reliable products.</p>
        </div>

        <div class="card">
            <div class="icon">💰</div>
            <h3>Best Pricing</h3>
            <p>Competitive wholesale prices to maximize your profit margins.</p>
        </div>

        <div class="card">
            <div class="icon">🚚</div>
            <h3>Fast Delivery</h3>
            <p>Quick dispatch and reliable delivery across India.</p>
        </div>

        <div class="card">
            <div class="icon">🤝</div>
            <h3>Trusted Partnership</h3>
            <p>We build long-term relationships with retailers and distributors.</p>
        </div>

        <div class="card">
            <div class="icon">⚡</div>
            <h3>Latest Trends</h3>
            <p>Stay ahead with trending and high-demand mobile accessories.</p>
        </div>

    </div>

    <!-- ✅ HIGHLIGHT SECTION -->
    <div class="highlight-box">
        <h2>Growing with SRV India</h2>
        <p>We are helping businesses scale faster with reliable supply and quality products.</p>

        <div style="display:flex; justify-content:space-around; flex-wrap:wrap; margin-top:20px;">
            <div>
                <div class="counter" data-target="100">0</div>
                <p>Clients</p>
            </div>

            <div>
                <div class="counter" data-target="50">0</div>
                <p>Cities</p>
            </div>

            <div>
                <div class="counter" data-target="500">0</div>
                <p>Products</p>
            </div>
        </div>
    </div>

</div>

<!-- ✅ JS ANIMATION -->
@section Scripts {
    <script>
        // Card animation
        document.querySelectorAll(".card").forEach((card, i) => {
            card.style.opacity = "0";
            card.style.transform = "translateY(20px)";

            setTimeout(() => {
                card.style.transition = "0.5s";
                card.style.opacity = "1";
                card.style.transform = "translateY(0)";
            }, i * 150);
        });

        // Counter animation
        const counters = document.querySelectorAll(".counter");

        counters.forEach(counter => {
            const update = () => {
                const target = +counter.getAttribute("data-target");
                const count = +counter.innerText;

                const speed = target / 50;

                if (count < target) {
                    counter.innerText = Math.ceil(count + speed);
                    setTimeout(update, 30);
                } else {
                    counter.innerText = target;
                }
            };

            update();
        });
    </script>
}