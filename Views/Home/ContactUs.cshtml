@model SRVIndia.Models.Enquiries;
@{
    ViewData["Title"] = "Home Page";
}
<div class="wrapper">
    <div class="breadcrumb"><a href="../index.html">Home</a><a href="../About-Us/index.html">About SRV</a><strong>Contact </strong></div>
</div>

<div class="wrapper contact-wrapper">
    <div class="contact-form">
        <h1>GET IN TOUCH</h1>
        <div class="privacynote"><p> The information you submit will only be used for our reply to your message and will not be shared or sent to third parties, as explained in the additional information. You can consult additional and detailed information in our <a href="../Privacy/index.html">Privacy Policy</a>.</p></div>
        <form asp-action="SaveEnquiry" method="post">
            <div id="contactForm" class="wow fadeInUp" data-wow-delay="0.8s">
                <div class="input-form">
                    <div class="input-box">
                        <input type="text" asp-for="PersonName" placeholder="Name" class="customerName">
                    </div>
                    <div class="input-box">
                        <input type="text" asp-for="UserEmail" placeholder="E-mail" class="company">
                    </div>
                    <div class="input-box">
                        <input type="text" asp-for="MobileNo" placeholder="MobileNo" class="whatsapp">
                    </div>
                    @* <div class="input-box">
                                    <input type="email" asp-for="UserEmail" placeholder="E-mail" class="email">
                                    </div> *@
                    <div class="input-box">
                        <div class="select-selected">Select State</div>
                        <div class="select-list">
                            <!-- States -->
                            <div class="select-option">Andhra Pradesh</div>
                            <div class="select-option">Arunachal Pradesh</div>
                            <div class="select-option">Assam</div>
                            <div class="select-option">Bihar</div>
                            <div class="select-option">Chhattisgarh</div>
                            <div class="select-option">Goa</div>
                            <div class="select-option">Gujarat</div>
                            <div class="select-option">Haryana</div>
                            <div class="select-option">Himachal Pradesh</div>
                            <div class="select-option">Jharkhand</div>
                            <div class="select-option">Karnataka</div>
                            <div class="select-option">Kerala</div>
                            <div class="select-option">Madhya Pradesh</div>
                            <div class="select-option">Maharashtra</div>
                            <div class="select-option">Manipur</div>
                            <div class="select-option">Meghalaya</div>
                            <div class="select-option">Mizoram</div>
                            <div class="select-option">Nagaland</div>
                            <div class="select-option">Odisha</div>
                            <div class="select-option">Punjab</div>
                            <div class="select-option">Rajasthan</div>
                            <div class="select-option">Sikkim</div>
                            <div class="select-option">Tamil Nadu</div>
                            <div class="select-option">Telangana</div>
                            <div class="select-option">Tripura</div>
                            <div class="select-option">Uttar Pradesh</div>
                            <div class="select-option">Uttarakhand</div>
                            <div class="select-option">West Bengal</div>

                            <!-- Union Territories -->
                            <div class="select-option">Andaman and Nicobar Islands</div>
                            <div class="select-option">Chandigarh</div>
                            <div class="select-option">Dadra and Nagar Haveli and Daman and Diu</div>
                            <div class="select-option">Delhi</div>
                            <div class="select-option">Jammu and Kashmir</div>
                            <div class="select-option">Ladakh</div>
                            <div class="select-option">Lakshadweep</div>
                            <div class="select-option">Puducherry</div>
                        </div>
                        <input type="hidden" asp-for="States" class="cargo" value="">
                    </div>
                    <div class="input-box">
                        <div class="select-selected">Are You?</div>
                        <div class="select-list">
                            <div class="select-option">Retail</div>
                            <div class="select-option">Distributor</div>
                            <div class="select-option">Wholesaler</div>
                            <div class="select-option">Others</div>
                        </div>
                        <input type="hidden" asp-for="BusinessType" class="business" value="">
                    </div>
                    <div class="input-textarea">
                        <textarea asp-for="UserMessage" class="message" placeholder="Your messages here!"></textarea>
                    </div>

                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-primary">Send Enquiry</button>
                </div>

            </div><!--contactForm-->
        </form>
    </div>


    <div class="contact-list">
        <div class="contact-title">Contact Us</div>
        <div class="branch">Below Contact.</div>
        <dl class="wow fadeInUp">
            <dt>E-mail</dt>
            <dd><a href="mailto:contact@srvindia.co.in">contact@srvindia.co.in</a></dd>
        </dl>
        <dl class="wow fadeInUp" data-wow-delay="0.2s">
            <dt>Phone </dt>
            <dd>+91 9920216620</dd>
        </dl>
        <dl class="wow fadeInUp" data-wow-delay="0.2s">
            <dt>WhatsApp </dt>
            <dd><a href="#">+91 9920216620</a></dd>
        </dl>

        <dl class="wow fadeInUp" data-wow-delay="0.6s">
            <dt>Headquarters</dt>
            <dd>Mumbai-Maharastra</dd>
        </dl>

        <dl class="wow fadeInUp" data-wow-delay="0.4s">
            <dt>Office</dt>
            <dd>LH-111,2nd Floor, The Platinum Mall,Pathe Bapurao Marg, Grand Road (East), Mumbai-400004.</dd>
        </dl>
    </div>

</div><!--/wrapper-->