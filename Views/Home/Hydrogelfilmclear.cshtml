@{
    ViewData["Title"] = "SRV India - Hydrogel Film HD Clear Screen Protector";
}

<!-- Optional icons/font (CDN) -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<!-- ===================== BREADCRUMB ===================== -->
<section class="breadcrumb-section">
    <div class="wrapper">
        <nav class="breadcrumb" aria-label="breadcrumb">
            <a asp-controller="Home" asp-action="Index">Home</a>

            <a asp-controller="Products" asp-action="Index">Products</a>

            <strong>Hydrogel Film HD Clear</strong>
        </nav>
    </div>
</section>

<!-- ===================== PRODUCT HERO ===================== -->
<section class="product-detail-section">
    <div class="wrapper">
        <div class="product-detail-page">

            <!-- Left: Product Image -->
            <div class="product-image-area" aria-label="Product image">
                <figure class="main-product-image">
                    <img src="~/images/Products/HYDROGEL FILM CLEAR.PNG" alt="SRV India Hydrogel Film HD Clear Screen Protector" />
                </figure>

                @* <div class="product-badges" aria-label="Key highlights">
                    <span class="badge"><i class="fa-solid fa-eye" aria-hidden="true"></i> HD Clear</span>
                    <span class="badge"><i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i> Self-Healing</span>
                    <span class="badge"><i class="fa-solid fa-hand" aria-hidden="true"></i> Smooth Touch</span>
                    <span class="badge"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i> Scratch Proof</span>
                </div> *@
            </div>

            <!-- Right: Product Info -->
            <div class="product-info-area">

                <h1>SRV — Hydrogel Film<br /><span class="brand-name">Available</span></h1>
                <h2>Self-Healing HD Clear Protective Film</h2>
                <p class="product-short-desc">
                    SRV India Hydrogel Film HD Clear is a flexible, self-healing protective
                    film that wraps edge-to-edge over curved smartphone displays. Crystal-clear
                    HD transparency keeps your screen looking exactly as it should, while a
                    scratch-proof, smooth-touch surface protects it from daily wear.
                </p>

                <!-- Features -->
                <div class="product-features" aria-label="Product features">

                    <div class="feature-box">
                        <div class="feature-icon" aria-hidden="true">
                            <i class="fa-solid fa-eye"></i>
                        </div>
                        <div>
                            <h3>Shows Original Product</h3>
                            <p>99.9% HD transparency preserves your display's true colours, brightness and sharpness.</p>
                        </div>
                    </div>

                    <div class="feature-box">
                        <div class="feature-icon" aria-hidden="true">
                            <i class="fa-solid fa-wand-magic-sparkles"></i>
                        </div>
                        <div>
                            <h3>Self-Healing Surface</h3>
                            <p>Minor scratches and swirl marks fade on their own within 24 hours.</p>
                        </div>
                    </div>

                    <div class="feature-box">
                        <div class="feature-icon" aria-hidden="true">
                            <i class="fa-solid fa-hand"></i>
                        </div>
                        <div>
                            <h3>Smooth Touch</h3>
                            <p>Soft-touch surface glides naturally under your fingers, keeping swipes and typing responsive.</p>
                        </div>
                    </div>

                    <div class="feature-box">
                        <div class="feature-icon" aria-hidden="true">
                            <i class="fa-solid fa-screwdriver-wrench"></i>
                        </div>
                        <div>
                            <h3>Easy to Install</h3>
                            <p>Flexible film aligns and applies smoothly at home — no bubbles, no special tools required.</p>
                        </div>
                    </div>

                    <div class="feature-box">
                        <div class="feature-icon" aria-hidden="true">
                            <i class="fa-solid fa-shield-halved"></i>
                        </div>
                        <div>
                            <h3>Scratch Proof</h3>
                            <p>Durable film resists everyday nicks and scuffs from keys, bags and daily handling.</p>
                        </div>
                    </div>

                    <div class="feature-box">
                        <div class="feature-icon" aria-hidden="true">
                            <i class="fa-solid fa-mobile-screen"></i>
                        </div>
                        <div>
                            <h3>Full Curved Edge Coverage</h3>
                            <p>Flexible hydrogel material wraps completely around curved displays — no white edges, no lifting.</p>
                        </div>
                    </div>

                </div>


                @* <div class="pack-info" aria-label="Pack information">
                    <span class="pack-badge"><i class="fa-solid fa-box"></i> Size: 120*195mm</span>
                    <span class="pack-badge"><i class="fa-solid fa-circle-check"></i> Imported Premium Material</span>
                </div> *@

                <div class="product-buttons" aria-label="Actions">
                    <a asp-controller="Home" asp-action="DistributorForm" id="enquiry" class="primary-btn">
                        <i class="fa-solid fa-user-tie" aria-hidden="true"></i>
                        <span>Become a Dealer</span>
                    </a>
                    <a href="#model-list" class="secondary-btn">
                        <i class="fa-solid fa-list-check" aria-hidden="true"></i>
                        <span>View Model List</span>
                    </a>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- ===================== INTRODUCTION PANEL ===================== -->
<section class="tab-panel active" id="tab-intro">
    <div class="wrapper">
        <div class="content-flex">
            <div class="content-text">
                <h3>HD Clear — Maximum Clarity, Zero Compromise</h3>
                <p>
                    Rigid tempered glass can't always follow the curve of today's edge
                    displays. SRV India Hydrogel Film HD Clear is built from a flexible,
                    self-healing polymer that conforms fully to curved and flat screens alike
                    — sealing the entire surface edge-to-edge without a visible border or
                    lifted corner.
                </p>
                <p>
                    The HD Clear finish delivers crystal-sharp visual clarity, showing your
                    display exactly as the manufacturer intended, while a self-healing surface
                    quietly repairs light scratches and swirl marks within 24 hours.
                </p>
                <p>
                    Finished with a smooth, scratch-proof coating and cut to a universal
                    120 x 195mm sheet for on-site trimming, Hydrogel Film HD Clear installs
                    easily at home or in-store. Imported premium material, ready for retail
                    and dealer use.
                </p>
            </div>
            <div class="content-image" aria-label="Product detail image">
                <img src="~/images/Products/HYDROGEL FILM CLEAR.PNG" alt="SRV India Hydrogel Film HD Clear Detail" />
            </div>
        </div>
    </div>
</section>

<!-- ===================== SPECIFICATIONS PANEL ===================== -->
<section class="tab-panel" id="tab-specs">
    <div class="wrapper">
        <h2 class="section-title">Product Specifications</h2>

        <div class="spec-grid">
            <div class="spec-item"><div class="spec-icon"><i class="fa-solid fa-flask"></i></div><h4>Material</h4><p>Hydrogel TPU Film</p></div>
            <div class="spec-item"><div class="spec-icon"><i class="fa-solid fa-eye"></i></div><h4>Finish</h4><p>HD Clear</p></div>
            <div class="spec-item"><div class="spec-icon"><i class="fa-solid fa-ruler-combined"></i></div><h4>Sheet Size</h4><p>120 x 195mm Universal</p></div>
            <div class="spec-item"><div class="spec-icon"><i class="fa-solid fa-wand-magic-sparkles"></i></div><h4>Self-Healing</h4><p>Within 24 Hours</p></div>
            <div class="spec-item"><div class="spec-icon"><i class="fa-solid fa-mobile-screen"></i></div><h4>Coverage</h4><p>Full Curved Edge Coverage</p></div>
            <div class="spec-item"><div class="spec-icon"><i class="fa-solid fa-hand"></i></div><h4>Touch</h4><p>Smooth Touch Response</p></div>
            <div class="spec-item"><div class="spec-icon"><i class="fa-solid fa-shield-halved"></i></div><h4>Durability</h4><p>Scratch Proof Coating</p></div>
            <div class="spec-item"><div class="spec-icon"><i class="fa-solid fa-screwdriver-wrench"></i></div><h4>Install</h4><p>Easy Self-Install</p></div>
            <div class="spec-item"><div class="spec-icon"><i class="fa-solid fa-layer-group"></i></div><h4>Origin</h4><p>Imported Premium Material</p></div>
        </div>
    </div>
</section>

<!-- ===================== FEATURES PANEL ===================== -->
<section class="tab-panel" id="tab-features">
    <div class="wrapper">
        <h2 class="section-title">Why HD Clear Stands Apart</h2>

        <div class="features-grid">
            <div class="feat-card">
                <div class="feat-num">01</div>
                <h4>True-to-Original Display</h4>
                <p>HD-grade clarity means your screen looks exactly as the manufacturer intended.</p>
            </div>

            <div class="feat-card">
                <div class="feat-num">02</div>
                <h4>Self-Healing Hydrogel Surface</h4>
                <p>Light scratches and swirl marks fade on their own — no glass cracks to worry about.</p>
            </div>

            <div class="feat-card">
                <div class="feat-num">03</div>
                <h4>True Edge-to-Edge Coverage</h4>
                <p>Flexible film wraps fully around curved displays with no white borders or lifted edges.</p>
            </div>

            <div class="feat-card">
                <div class="feat-num">04</div>
                <h4>Scratch Proof & Smooth Touch</h4>
