<div class="spinner"></div>
</div>-->

									<script>
										// Function to show the active swatch image
										function showActiveSwatchImage() {
											jQuery('.custom-swatch li.active').each(function () {
												var color = jQuery(this).data('color');
												var product = jQuery(this).closest('.product');
												product.find('.product-image').hide();
												product.find('.product-image.' + color).show();
											});
											console.log('active image', 'true');
										}

										// Function to rebind hover and click event handlers
										function rebindSwatchHandlers() {
											jQuery('.custom-swatch li').off('mouseenter mouseleave click'); // Unbind previous handlers

											jQuery('.custom-swatch li').hover(function () {
												var color = jQuery(this).data('color');
												var product = jQuery(this).closest('.product');

												product.find('.product-image').hide();
												product.find('.product-image.' + color).show();
											}, function () {
												var product = jQuery(this).closest('.product');
												var activeColor = product.find('.custom-swatch li.active').data('color');

												product.find('.product-image').hide();
												product.find('.product-image.' + activeColor).show();
											});

											jQuery('.custom-swatch li').click(function () {
												var color = jQuery(this).data('color');
												var product = jQuery(this).closest('.product');

												product.find('.custom-swatch li').removeClass('active');
												jQuery(this).addClass('active');

												product.find('.product-image').hide();
												product.find('.product-image.' + color).show();
											});
											console.log('active handler', 'true');
										}

										// Show the image corresponding to the active swatch on page load
										jQuery(document).ready(function () {
											showActiveSwatchImage();
											rebindSwatchHandlers();

											// Handle showing the correct image and rebinding handlers when .tab-content is shown

										});

										jQuery(function () {
											var tabSwitch = jQuery(".tab-switch");
											var tabContent = jQuery(".tab-container");

											tabSwitch.find(".tab").on("click", function () {
												var $this = jQuery(this);

												if ($this.hasClass("active")) return;

												var direction = $this.attr("tab-direction");
												var target = $this.attr("tab-target");

												tabSwitch.removeClass("left right").addClass(direction);
												tabSwitch.find(".tab.active").removeClass("active");
												$this.addClass("active");

												tabContent.find(".tab-content.active")
													.removeClass("active")
													.css({ opacity: 0, visibility: 'hidden', height: 0, overflow: 'hidden', position: 'absolute' });

												tabContent.find(target)
													.addClass("active")
													.css({ opacity: 1, visibility: 'visible', height: 'auto', overflow: 'visible', position: 'relative' });

												showActiveSwatchImage();
												rebindSwatchHandlers();
											});
										});

										jQuery(document).ready(function ($) {
											$(window).on('load', function () {
												$('#star-products-slider').removeClass('swiper-loader');
												$('#trending-slider').removeClass('swiper-loader');
												requestAnimationFrame(() => {
													// Use setTimeout to ensure elements are fully rendered before initializing Swiper
													setTimeout(() => {
														initializeSwiper('#star-products-slider .swiper');
														initializeSwiper('#trending-slider .swiper');
													}, 100); // Adjust the delay as necessary
												});
											});

											function initializeSwiper(selector) {
												const swiperTarget = $(selector);

												// Destroy existing Swiper instance if it exists
												if (swiperTarget[0].swiper) {
													swiperTarget[0].swiper.destroy(true, true);
													console.log("Swiper Destroyed for " + selector);
												}

												// Append the scrollbar element dynamically
												const scrollbarEl = document.createElement('div');
												scrollbarEl.className = 'swiper-scrollbar';
												swiperTarget.append(scrollbarEl);

												// Initialize Swiper with settings
												const swiperInstance = new Swiper(swiperTarget[0], {
													slidesPerView: 4,
													loop: false,
													freeMode: true,
													spaceBetween: 10,
													scrollbar: {
														el: scrollbarEl,
														draggable: true,
														hide: false,
														dragSize: 150,
													},
													breakpoints: {
														320: {
															slidesPerView: 1.5,
															spaceBetween: 10,
														},
														480: {
															slidesPerView: 2.5,
															spaceBetween: 20,
														},
														640: {
															slidesPerView: 3.5,
															spaceBetween: 30,
														},
														768: {
															slidesPerView: 4.4,
															spaceBetween: 10,
														},
														1200: {
															slidesPerView: 5,
															spaceBetween: 10,
														},
													},
												});

												// Update scrollbar and Swiper instance
												swiperInstance.scrollbar.updateSize();
												swiperInstance.update();
												swiperTarget.addClass('finally-initialized')
											}
										});

									</script>
								</div>
							</div>
					</div>
				</div>
