@{
    ViewData["Title"] = "E-Waste Awareness";
}

<!-- ✅ CSS -->
<style>
    body {
        font-family: 'Segoe UI', sans-serif;
        background: #f4f9f6;
    }

    /* 🌱 HERO */
    .heroH {
        background: linear-gradient(135deg, #11998e, #38ef7d);
        color: white;
        text-align: center;
        padding: 30px 0px;
    }

        .heroH h1 {
            font-size: 2.8rem;
        }

        .heroH p {
            font-size: 1.2rem;
        }

    /* Container */
    .container {
        max-width: 1100px;
        margin: auto;
        padding: 20px 0px;
    }

    /* Section Title */
    .title {
        text-align: center;
        font-size: 1.8rem;
        margin-bottom: 20px;
    }

    /* Grid */
    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
    }

    /* Card */
    .card {
        background: white;
        padding: 25px;
        border-radius: 15px;
        text-align: center;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        transition: 0.4s;
    }

        .card:hover {
            transform: translateY(-8px);
        }

    /* Icon */
    .icon {
        font-size: 45px;
        margin-bottom: 10px;
    }

    /* Highlight */
    .highlight {
        margin-top: 50px;
        background: linear-gradient(135deg, #00c853, #64dd17);
        color: white;
        padding: 40px;
        border-radius: 20px;
        text-align: center;
    }

    /* Button */
    .btn {
        display: inline-block;
        margin-top: 15px;
        padding: 10px 20px;
        background: white;
        color: #00c853;
        border-radius: 5px;
        text-decoration: none;
    }

    /* Responsive */
    @@media(max - width:600px) {
        .heroH h1 {
            font-size: 2rem;
        }
    }
</style>

<!-- 🌱 HERO -->
<div class="heroH">
    <h1>E-Waste Awareness</h1>
    <p>Recycle Today for a Better Tomorrow</p>
</div>

<div class="container">

    <!-- ✅ INTRO -->
    <div class="title">What is E-Waste?</div>
    <p style="text-align:center; max-width:800px; margin:auto;">
        E-waste refers to discarded electronic devices such as mobile phones, chargers,
        cables, and accessories. Improper disposal of e-waste can harm the environment
        and human health. At <strong>SRV India</strong>, we are committed to promoting
        responsible recycling and sustainability.
    </p>

    <!-- ✅ IMPACT -->
    <div class="title" style="margin-top:40px;">Why E-Waste Matters</div>

    <div class="grid">
        <div class="card">
            <div class="icon">🌍</div>
            <h3>Environmental Impact</h3>
            <p>E-waste releases harmful chemicals that pollute soil and water.</p>
        </div>

        <div class="card">
            <div class="icon">⚠️</div>
            <h3>Health Risks</h3>
            <p>Improper handling can cause serious health issues.</p>
        </div>

        <div class="card">
            <div class="icon">♻️</div>
            <h3>Recycling Value</h3>
            <p>Electronic waste contains valuable materials that can be reused.</p>
        </div>
    </div>

    <!-- ✅ RESPONSIBILITY -->
    <div class="title" style="margin-top:40px;">Our Responsibility</div>

    <div class="grid">
        <div class="card">
            <div class="icon">📦</div>
            <h3>Reduce Waste</h3>
            <p>We focus on durable products to reduce electronic waste generation.</p>
        </div>

        <div class="card">
            <div class="icon">🔄</div>
            <h3>Recycle</h3>
            <p>Encouraging customers to recycle old mobile accessories responsibly.</p>
        </div>

        <div class="card">
            <div class="icon">🤝</div>
            <h3>Awareness</h3>
            <p>Spreading awareness about safe disposal practices.</p>
        </div>
    </div>

    <!-- ✅ TIPS -->
    <div class="title" style="margin-top:40px;">What You Can Do</div>

    <div class="grid">
        <div class="card">
            <div class="icon">📱</div>
            <h3>Donate Devices</h3>
            <p>Give old devices to those in need instead of throwing them away.</p>
        </div>

        <div class="card">
            <div class="icon">🏭</div>
            <h3>Use Authorized Centers</h3>
            <p>Dispose of e-waste through certified recycling centers only.</p>
        </div>

        <div class="card">
            <div class="icon">📢</div>
            <h3>Spread Awareness</h3>
            <p>Educate others about the importance of e-waste recycling.</p>
        </div>
    </div>

    <!-- ✅ CTA -->
    <div class="highlight">
        <h2>Join SRV India in Building a Greener Future 🌱</h2>
        <p>Together, we can reduce e-waste and protect our environment.</p>
        <a asp-area="" asp-controller="Home" asp-action="ContactUs" class="btn">Contact Us</a>
    </div>

</div>

<!-- ✅ JS ANIMATION -->
@section Scripts {
    <script>
        document.querySelectorAll(".card").forEach((card, i) => {
            card.style.opacity = "0";
            card.style.transform = "translateY(20px)";

            setTimeout(() => {
                card.style.transition = "0.5s";
                card.style.opacity = "1";
                card.style.transform = "translateY(0)";
            }, i * 150);
        });
    </script>
}