                <figure class="main-product-image">
                    <img src="~/images/Products/NanoGuard.PNG" alt="SRV India HD Clear Screen Protector Detail" />
                </figure>

                @* <div class="product-badges" aria-label="Key highlights">
                    <span class="badge"><i class="fa-solid fa-shield-heart" aria-hidden="true"></i> 9H Hardness</span>
                    <span class="badge"><i class="fa-solid fa-bolt" aria-hidden="true"></i> Antistatic</span>
                    <span class="badge"><i class="fa-solid fa-snowflake" aria-hidden="true"></i> HD Dustproof</span>
                    <span class="badge"><i class="fa-solid fa-microchip" aria-hidden="true"></i> ESD Shield</span>
                    <span class="badge"><i class="fa-solid fa-hand" aria-hidden="true"></i> Anti Fingerprint</span>
                </div> *@
            </div>

            <!-- Right: Product Info -->
            <div class="product-info-area">

                <h1>SRV Nano Guard Matte Hydrogel Film <br /><span class="brand-name">Available</span></h1>
                <h2>Advanced Nano Protection with a Premium Matte Finish</h2>
                <p class="product-short-desc">
                    SRV Nano Guard Matte Hydrogel Film is engineered to provide superior screen protection while delivering 
                    a smooth, glare-free viewing experience. Built with advanced Nano Guard technology and premium TPU hydrogel
                    material, it offers exceptional flexibility, durability, and edge-to-edge coverage for modern smartphones.
                </p>

                <!-- Features -->
                <div class="product-features" aria-label="Product features">

                    <div class="feature-box">
                        <i class="fa-solid fa-shield-virus"></i>
                        <h3>Nano Guard Protection</h3>
                        <p>Advanced Nano Guard technology provides enhanced durability and reliable protection against everyday damage.</p>
                    </div>

                    <div class="feature-box">
                        <i class="fa-solid fa-sun"></i>
                        <h3>Matte Anti-Glare Finish</h3>
                        <p>Reduces screen reflections and glare for a more comfortable viewing experience in bright environments.</p>
                    </div>

                    <div class="feature-box">
                        <i class="fa-solid fa-hand-pointer"></i>
                        <h3>Ultra Smooth Touch</h3>
                        <p>Silky matte surface ensures fast, accurate, and responsive touch performance for gaming, browsing, and typing.</p>
                    </div>

                    <div class="feature-box">
                        <i class="fa-solid fa-wand-magic-sparkles"></i>
                        <h3>Self-Healing Technology</h3>
                        <p>Automatically minimizes minor scratches and small installation bubbles within 24 hours.</p>
                    </div>

                    <div class="feature-box">
                        <i class="fa-solid fa-shield-halved"></i>
                        <h3>Scratch Resistant</h3>
                        <p>Protects your smartphone display from scratches caused by keys, coins, and daily use.</p>
                    </div>

                    <div class="feature-box">
                        <i class="fa-solid fa-mobile-screen-button"></i>
                        <h3>Full Screen Coverage</h3>
                        <p>Flexible hydrogel material delivers precise edge-to-edge protection for flat and curved displays.</p>
                    </div>

                </div>


                @* <div class="pack-info" aria-label="Pack information">
                    <span class="pack-badge"><i class="fa-solid fa-box"></i> Inner Pack: 10 PCS</span>
                    <span class="pack-badge"><i class="fa-solid fa-circle-check"></i> Genuine Trusted Premium Quality</span>
                </div> *@

                <div class="product-buttons" aria-label="Actions">
                    <a asp-controller="Home" asp-action="DistributorForm" id="enquiry" class="primary-btn">
                        <i class="fa-solid fa-user-tie" aria-hidden="true"></i>
                        <span>Become a Dealer</span>
                    </a>
                    <a href="#model-list" class="secondary-btn">
                        <i class="fa-solid fa-list-check" aria-hidden="true"></i>
                        <span>View Model List</span>
                    </a>
                </div>
            </div>

        </div>
    </div>
</section>

