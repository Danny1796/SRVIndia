@{
    ViewData["Title"] = "SRV Kinetic Machine";
}

<!-- ✅ CSS -->
<style>
    body {
        font-family: 'Segoe UI', sans-serif;
        background: #f4f6fb;
    }

    /* 🔥 HERO */
    .heroM{
        background: linear-gradient(135deg,#1e3c72, #2a5298);
        color: white;
        padding: 30px 0px;
        text-align: center;
    }

        .heroM h1 {
            font-size: 2.8rem;
        }

        .heroM p {
            font-size: 1.2rem;
            opacity: 0.9;
        }

    /* Container */
    .container {
        max-width: 1100px;
        margin: auto;
        padding: 20px 0px;
    }

    /* Product Section */
    .product-box {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        align-items: center;
        gap: 30px;
    }

    /* Image */
    .product-img img {
        width: 100%;
        border-radius: 15px;
    }

    /* Content */
    .product-content h2 {
        color: #333;
        margin-bottom: 10px;
    }

    .product-content p {
        color: #555;
    }

    /* Features */
    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-top: 40px;
    }

    /* Card */
    .card {
        background: white;
        padding: 25px;
        border-radius: 15px;
        text-align: center;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        transition: 0.4s;
    }

        .card:hover {
            transform: translateY(-8px);
        }

    /* Icon */
    .icon {
        font-size: 40px;
        margin-bottom: 10px;
    }

    /* Highlight */
    .highlight {
        margin-top: 50px;
        background: linear-gradient(135deg, #00c6ff, #0072ff);
        color: white;
        padding: 40px;
        border-radius: 20px;
        text-align: center;
    }

    /* Button */
    .btn {
        display: inline-block;
        margin-top: 15px;
        padding: 10px 20px;
        background: white;
        color: #0072ff;
        border-radius: 5px;
        text-decoration: none;
    }
</style>

<!-- 🔥 HERO -->
<div class="heroM">
    <h1>SRV Kinetic</h1>
    <p>Screen Protector Cutting Machine</p>
</div>

<div class="container">

    <!-- ✅ PRODUCT SECTION -->
    <div class="product-box">

        <!-- IMAGE -->
        <div class="product-img">
            <img src="~/images/srvmachine.png" alt="SRV Kinetic Machine">
        </div>

        <!-- CONTENT -->
        <div class="product-content">
            <h2>SRV Kinetic Screen Protector Cutting Machine</h2>
            <p>
                The <strong>SRV Kinetic Screen Protector Cutting Machine</strong> is designed
                to meet the needs of devices across all screen sizes — from smartwatches
                to large PC monitors.
            </p>

            <p>
                It delivers <strong>precise, reliable, and high-speed cutting performance</strong>,
                making it ideal for mobile shops, retailers, and service centers.
            </p>
        </div>

    </div>

    <!-- ✅ FEATURES -->
    <div class="grid">

        <div class="card">
            <div class="icon">📱</div>
            <h3>All Device Support</h3>
            <p>Supports cutting for mobiles, tablets, smartwatches, and PC screens.</p>
        </div>

        <div class="card">
            <div class="icon">🎯</div>
            <h3>High Precision</h3>
            <p>Accurate cutting ensures perfect fitting for every device.</p>
        </div>

        <div class="card">
            <div class="icon">⚡</div>
            <h3>Fast Performance</h3>
            <p>Quick cutting process saves time and increases efficiency.</p>
        </div>

        <div class="card">
            <div class="icon">📲</div>
            <h3>Mobile App Control</h3>
            <p>Connect via mobile app for easy operation and updates.</p>
        </div>

        <div class="card">
            <div class="icon">🤖</div>
            <h3>Auto Settings</h3>
            <p>Automatic parameter adjustment for better accuracy.</p>
        </div>

        <div class="card">
            <div class="icon">🔧</div>
            <h3>Easy to Use</h3>
            <p>User-friendly interface for smooth operation.</p>
        </div>

    </div>

    <!-- ✅ HIGHLIGHT -->
    <div class="highlight">
        <h2>Boost Your Business with SRV Kinetic</h2>
        <p>
            Upgrade your mobile shop with advanced cutting technology and
            provide customized screen protection instantly.
        </p>

        <a asp-area="" asp-controller="Home" asp-action="ContactUs" class="btn">Contact Us</a>
    </div>

</div>

<!-- ✅ JS ANIMATION -->
@section Scripts {
    <script>
        document.querySelectorAll(".card").forEach((card, i) => {
            card.style.opacity = "0";
            card.style.transform = "translateY(20px)";

            setTimeout(() => {
                card.style.transition = "0.5s";
                card.style.opacity = "1";
                card.style.transform = "translateY(0)";
            }, i * 150);
        });
    </script>
}